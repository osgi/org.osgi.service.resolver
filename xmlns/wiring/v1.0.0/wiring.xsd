<schema xmlns="http://www.w3.org/2001/XMLSchema"
    xmlns:wir="http://www.osgi.org/xmlns/wiring/v1.0.0"
    targetNamespace="http://www.osgi.org/xmlns/wiring/v1.0.0"
    elementFormDefault="qualified"
    attributeFormDefault="unqualified"
    version="1.0.0">

    <element name="wiring" type="wir:Twiring" />

    <complexType name="Twiring">
        <annotation>
            <documentation xml:lang="en">
                The outcome of one resolve operation: the resources of the input with, for the
                resolved ones, the wires of their requirements. Resources that did not resolve
                are optional and marked with resolved="false".
                Writers should emit resources sorted by key and wires sorted by
                (namespace, filter, provider, capability, version, index), so two equal outcomes
                are textually equal and can be compared with a plain diff.
            </documentation>
        </annotation>
        <sequence>
            <element name="resource" type="wir:Tresource" minOccurs="0" maxOccurs="unbounded" />
            <any namespace="##other" processContents="lax" minOccurs="0" maxOccurs="unbounded" />
        </sequence>
        <attribute name="name" type="string">
            <annotation>
                <documentation xml:lang="en">
                    A free name of the wiring, for example the scenario or the state it belongs to.
                </documentation>
            </annotation>
        </attribute>
        <attribute name="repository" type="anyURI">
            <annotation>
                <documentation xml:lang="en">
                    The repository XML (absolute or relative to this document) the wiring was resolved against.
                    Informational only, the resource keys are what identifies a resource.
                </documentation>
            </annotation>
        </attribute>
        <attribute name="resolver" type="string">
            <annotation>
                <documentation xml:lang="en">
                    Informational: the resolver that produced the wiring. Must not influence a comparison.
                </documentation>
            </annotation>
        </attribute>
        <anyAttribute processContents="lax" />
    </complexType>

    <complexType name="Tresource">
        <annotation>
            <documentation xml:lang="en">
                A resource of the input. A resolved resource carries the wires that satisfy its
                requirements and is an empty element if it has none. An unresolved resource
                (resolved="false") has no wires and may name the requirements to blame.
                Recording unresolved resources lets a comparison tell "not resolved" from
                "not part of the input".
            </documentation>
        </annotation>
        <sequence>
            <element name="wire" type="wir:Twire" minOccurs="0" maxOccurs="unbounded" />
            <element name="requirement" type="wir:Trequirement" minOccurs="0" maxOccurs="unbounded" />
            <any namespace="##other" processContents="lax" minOccurs="0" maxOccurs="unbounded" />
        </sequence>
        <attribute name="key" type="wir:Tkey" use="required" />
        <attribute name="resolved" type="boolean" default="true" />
        <attribute name="signature" type="wir:Tsignature">
            <annotation>
                <documentation xml:lang="en">
                    Optional: the signature of the resolve relevant metadata of the resource (all its capabilities
                    and requirements, see README), not of its content. A consumer that wants to use the wires
                    compares it with the signature of its own resource: if it is equal the resource
                    offers and needs the same as when it was resolved. Ignored by a comparison unless both sides have it.
                </documentation>
            </annotation>
        </attribute>
        <attribute name="reason" type="string">
            <annotation>
                <documentation xml:lang="en">
                    Informational explanation why the resource is not resolved. Must not influence a comparison.
                </documentation>
            </annotation>
        </attribute>
        <anyAttribute processContents="lax" />
    </complexType>

    <complexType name="Trequirement">
        <annotation>
            <documentation xml:lang="en">
                A requirement of an unresolved resource that is to blame, identified like the requirement of a wire.
                Informational only, resolvers explain failures differently, so it must not influence a comparison.
            </documentation>
        </annotation>
        <attribute name="namespace" type="string" use="required" />
        <attribute name="filter" type="string" />
        <attribute name="reason" type="string" />
        <anyAttribute processContents="lax" />
    </complexType>

    <complexType name="Twire">
        <annotation>
            <documentation xml:lang="en">
                A wire from a requirement of the enclosing resource (the requirer) to a capability of the provider.
                The requirement is identified by namespace and filter, the capability by namespace,
                the value of its namespace attribute (the package name, the bundle symbolic name, ...)
                and its version. Requirement and capability ordinals are not used, they would change
                as soon as the repository is edited or minimized.
            </documentation>
        </annotation>
        <attribute name="namespace" type="string" use="required">
            <annotation>
                <documentation xml:lang="en">
                    The namespace of the requirement and of the capability.
                </documentation>
            </annotation>
        </attribute>
        <attribute name="filter" type="string">
            <annotation>
                <documentation xml:lang="en">
                    The filter directive of the requirement, absent if the requirement has none.
                </documentation>
            </annotation>
        </attribute>
        <attribute name="provider" type="wir:Tkey" use="required" />
        <attribute name="capability" type="string">
            <annotation>
                <documentation xml:lang="en">
                    The value of the attribute of the capability that is named like its namespace,
                    absent if the capability has none (for example custom namespaces).
                </documentation>
            </annotation>
        </attribute>
        <attribute name="version" type="string">
            <annotation>
                <documentation xml:lang="en">
                    The value of the version attribute of the capability, absent if it has none.
                </documentation>
            </annotation>
        </attribute>
        <attribute name="index" type="nonNegativeInteger" default="0">
            <annotation>
                <documentation xml:lang="en">
                    Only needed when the provider has several capabilities that agree in namespace, capability and
                    version: the position among exactly those, in document order of the repository.
                    A capability that a fragment hosts is a capability of the host (the provider) in the wire,
                    its position is the one among the capabilities of the fragment that declares it.
                </documentation>
            </annotation>
        </attribute>
        <anyAttribute processContents="lax" />
    </complexType>

    <simpleType name="Tsignature">
        <restriction base="string">
            <pattern value="sha256:[0-9a-f]{64}" />
        </restriction>
    </simpleType>

    <simpleType name="Tkey">
        <annotation>
            <documentation xml:lang="en">
                Identifies a resource by its osgi.identity capability:
                name "@" version [ "#" type ]
                where name and version are the osgi.identity and version attributes (version 0.0.0 if absent)
                and type is only written if it is not osgi.bundle.
                The key must be unique in the input, a producer must refuse an input where it is not.
            </documentation>
        </annotation>
        <restriction base="string">
            <pattern value="[^@#\s]+@[^#\s]+(#\S+)?" />
        </restriction>
    </simpleType>
</schema>
